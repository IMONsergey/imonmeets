{
  "name": "@imonmeets/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "better-auth": "1.7.14",
    "fastify": "5.12.7",
    "livekit-server-sdk": "2.19.2",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
