# Copy to a private file outside the checkout, chmod 600. Never commit a real key.
MEETS_TRANSLATION_ENABLED=false
SONIOX_API_KEY=
SONIOX_VOICE=Adrian
SONIOX_STT_MODEL=stt-rt-v6
SONIOX_ENDPOINT_DELAY_MS=2000
# Optional absolute path to private structured context JSON, mode 600.
SONIOX_CONTEXT_FILE=
MEETS_TRANSLATION_MAX_INPUT_SECONDS=300
MEETS_TRANSLATION_MAX_OUTPUT_SECONDS=600
MEETS_TRANSLATION_MAX_TEXT_CHARS=6000
# Durable attempt reservations, not a guaranteed provider invoice cap.
MEETS_TRANSLATION_RESERVATION_CENTS=50
MEETS_TRANSLATION_BUDGET_CENTS=500
# Set ONE absolute state directory shared by all runs on this host.
MEETS_TRANSLATION_STATE_DIR=/home/sergey/.local/state/imonmeets-soniox-pilot
