{
  "name": "imonmeets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "npm run dev -w @imonmeets/api",
    "dev:web": "npm run dev -w @imonmeets/web",
    "build": "npm run build -w @imonmeets/web && npm run build -w @imonmeets/api",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.e2e.json",
    "test": "npm run test -w @imonmeets/api && npm run test:web && npm run test:sdk",
    "migrate": "npm run migrate -w @imonmeets/api",
    "start": "npm run start -w @imonmeets/api",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests playwright.config.ts package.json compose.yml docs README.md",
    "format:check": "prettier --check apps packages tests playwright.config.ts package.json compose.yml docs README.md",
    "test:web": "node --import tsx --test apps/web/src/api.test.ts apps/web/src/calendar.test.ts",
    "test:ui": "node --import tsx apps/web/src/app.browser.test.ts",
    "test:sdk": "node --test --test-isolation=none packages/sdk/*.test.js",
    "test:external-media-policy": "node --test scripts/test-external-media-policy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  },
  "overrides": {
    "glob": "14.0.3"
  }
}
