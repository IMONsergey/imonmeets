# Local, isolated staging. Run node scripts/init-env.mjs to generate secrets.
APP_URL=http://localhost:3540
APP_ENV=development
PORT=3540
HOST=0.0.0.0
REGISTRATION_ENABLED=true
EMAIL_DELIVERY_MODE=capture
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAILS_PER_DAY=500
EMAILS_PER_WORKSPACE_DAY=100
EMAILS_PER_30D_BUCKET=15000
# Set only for authenticated Vercel-to-origin requests in the public review deployment.
ORIGIN_PROXY_SECRET=
# Local default; the public override uses a generated config file.
LIVEKIT_CONFIG_PATH=./deploy/livekit.local.yaml
# Local Mailpit receives actual verification emails; it does not deliver to the internet.
DEV_ALLOW_UNVERIFIED_EMAIL=false
BETTER_AUTH_SECRET=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME
APP_DATABASE_PASSWORD=GENERATE_ME
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=IMON Meets <meets@localhost.test>
SMTP_USER=
SMTP_PASSWORD=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=GENERATE_ME
LIVEKIT_API_SECRET=GENERATE_ME
# Set only after a reachable Egress worker and private S3 storage are tested.
RECORDING_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Admission limits are enforced server-side, independently of billing.
MAX_WORKSPACES_PER_USER=10
MAX_ROOMS_PER_WORKSPACE=200
MAX_MEMBERS_PER_WORKSPACE=100
MAX_PENDING_INVITATIONS=100
INVITATIONS_PER_USER_HOUR=20
MAX_ACTIVE_RECORDINGS=2
MAX_ACTIVE_ROOMS=20
# Optional relay: generate a secret, run prepare-turn.mjs as the operator,
# then add compose.turn.yml to COMPOSE_FILE. Generated files are private.
TURN_SHARED_SECRET=
TURN_UID=1000
TURN_GID=1000

# Optional Google OAuth (both values required together)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Commercial ingress. See docs/ingress443.md. Never reuse the occupied VPN IP.
INGRESS_PUBLIC_IP=
VPN_PUBLIC_IP=
TURN_INGRESS_443=false
TURN_PUBLIC_HOST=
TURN_TLS_PORT=443
LIVEKIT_SIGNALING_AUTH_ENABLED=false
LIVEKIT_SIGNALING_AUTH_SECRET=
S3_PUBLIC_ENDPOINT=
# Exact deployed identity, supplied by the release process, never guessed.
RELEASE_COMMIT=
RELEASE_IMAGE_DIGEST=
ANALYSIS_MODEL_MANIFEST_SHA256=

# Public support and exact owner-approved legal documents.
SUPPORT_EMAIL=
SUPPORT_HOURS=
PUBLIC_LEGAL_APPROVED=false
PUBLIC_LEGAL_MANIFEST_PATH=
PUBLIC_LEGAL_MANIFEST_SHA256=

# Production: initialize the journal and enroll an independent receiver first.
# compose.deletion.yml mounts /var/lib/imonmeets/deletion-journal.
DELETION_JOURNAL_DIR=
DELETION_JOURNAL_HOST_DIR=
DELETION_JOURNAL_KEY=
DELETION_RESTORE_REQUIRED=false
DELETION_WITNESS_URL=
DELETION_WITNESS_TOKEN=
DELETION_WITNESS_PUBLIC_KEY=
