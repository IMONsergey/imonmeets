# Local, isolated staging. Run node scripts/init-env.mjs to generate secrets.
APP_URL=http://localhost:3540
APP_ENV=development
PORT=3540
HOST=0.0.0.0
REGISTRATION_ENABLED=true
EMAIL_DELIVERY_MODE=capture
# Set only for authenticated Vercel-to-origin requests in the public review deployment.
ORIGIN_PROXY_SECRET=
# Local default; the public override uses a generated config file.
LIVEKIT_CONFIG_PATH=./deploy/livekit.local.yaml
# Local Mailpit receives actual verification emails; it does not deliver to the internet.
DEV_ALLOW_UNVERIFIED_EMAIL=false
BETTER_AUTH_SECRET=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME
APP_DATABASE_PASSWORD=GENERATE_ME
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=IMON Meets <meets@localhost.test>
SMTP_USER=
SMTP_PASSWORD=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=GENERATE_ME
LIVEKIT_API_SECRET=GENERATE_ME
# Set only after a reachable Egress worker and private S3 storage are tested.
RECORDING_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Admission limits are enforced server-side, independently of billing.
MAX_WORKSPACES_PER_USER=10
MAX_ROOMS_PER_WORKSPACE=200
MAX_MEMBERS_PER_WORKSPACE=100
MAX_PENDING_INVITATIONS=100
INVITATIONS_PER_USER_HOUR=20
EMAILS_PER_WORKSPACE_DAY=100
EMAILS_PER_DAY=500
MAX_ACTIVE_RECORDINGS=2
MAX_ACTIVE_ROOMS=20
# Optional relay: generate a secret, run prepare-turn.mjs as the operator,
# then add compose.turn.yml to COMPOSE_FILE. Generated files are private.
TURN_SHARED_SECRET=
TURN_UID=1000
TURN_GID=1000
