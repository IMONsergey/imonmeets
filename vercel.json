{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w @imonmeets/web",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "/sdk/v1/(embed|embed-protocol|index)\\.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300"
      },
      "continue": true
    },
    {
      "src": "/((?!embed/[A-Za-z0-9_-]{16,128}/?$).*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/embed/([A-Za-z0-9_-]{16,128})/?",
      "dest": "https://imonmeets-api.94-249-186-240.sslip.io:8443/embed/$1",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-imon-proxy-secret" },
          "args": "$ORIGIN_PROXY_SECRET",
          "env": ["ORIGIN_PROXY_SECRET"]
        }
      ]
    },
    {
      "src": "/api/(.*)",
      "dest": "https://imonmeets-api.94-249-186-240.sslip.io:8443/api/$1",
      "headers": {
        "Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-imon-proxy-secret"
          },
          "args": "$ORIGIN_PROXY_SECRET",
          "env": ["ORIGIN_PROXY_SECRET"]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
